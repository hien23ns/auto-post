{
  "name": "AI Auto Video Publisher 24/7 - Make Standalone Scenario",
  "description": "Kịch bản Make.com chạy 24/7 độc lập không cần VPS: Telegram Bot -> Gemini 2.5 Flash -> Duyệt bài -> Đăng Fanpage Reels & YouTube Shorts",
  "version": 1,
  "flow": [
    {
      "id": 1,
      "module": "telegram:watchUpdates",
      "version": 1,
      "parameters": {
        "limit": 10
      },
      "filter": {
        "name": "Chi nhan Video hoac Callback",
        "conditions": [
          [
            {
              "a": "{{1.message.video.file_id}}",
              "o": "exists"
            }
          ],
          [
            {
              "a": "{{1.callback_query.data}}",
              "o": "exists"
            }
          ]
        ]
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": -450,
          "y": 0,
          "name": "1. Telegram: Watch Updates"
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:router",
      "version": 1,
      "metadata": {
        "designer": {
          "x": -200,
          "y": 0,
          "name": "2. Phân loại sự kiện"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "telegram:getFile",
              "version": 1,
              "parameters": {},
              "mapper": {
                "file_id": "{{1.message.video.file_id}}"
              },
              "metadata": {
                "designer": {
                  "x": 50,
                  "y": -120,
                  "name": "3. Lấy link tải Video"
                }
              }
            },
            {
              "id": 4,
              "module": "http:ActionSendARequest",
              "version": 3,
              "parameters": {
                "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
                "method": "POST",
                "headers": [
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [
                  {
                    "name": "key",
                    "value": "{{var.gemini_api_key}}"
                  }
                ],
                "bodyType": "raw",
                "rawType": "json",
                "data": "{\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Bạn là chuyên gia Social Media tiếng Việt. Phân tích video và tạo nội dung cho 3 nền tảng: YouTube Shorts, Facebook Fanpage Reels, TikTok. Xuất đúng định dạng JSON: {\\\"youtube\\\": {\\\"title\\\": \\\"...\\\", \\\"caption\\\": \\\"...\\\", \\\"tags\\\": [\\\"#Shorts\\\", \\\"#XuHuong\\\"]}, \\\"facebook\\\": {\\\"caption\\\": \\\"...\\\", \\\"tags\\\": [\\\"#ReelsVN\\\"]}, \\\"tiktok\\\": {\\\"hook\\\": \\\"...\\\", \\\"tags\\\": [\\\"#fyp\\\"]}}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"response_mime_type\": \"application/json\",\n    \"temperature\": 0.2\n  }\n}"
              },
              "metadata": {
                "designer": {
                  "x": 300,
                  "y": -120,
                  "name": "4. Gemini 2.5 Flash: Phân tích & Viết nội dung"
                }
              }
            },
            {
              "id": 5,
              "module": "json:ParseJSON",
              "version": 1,
              "parameters": {
                "type": "string"
              },
              "mapper": {
                "json": "{{4.data.candidates[1].content.parts[1].text}}"
              },
              "metadata": {
                "designer": {
                  "x": 550,
                  "y": -120,
                  "name": "5. Đọc JSON từ Gemini"
                }
              }
            },
            {
              "id": 6,
              "module": "telegram:sendMessage",
              "version": 1,
              "parameters": {},
              "mapper": {
                "chat_id": "{{1.message.chat.id}}",
                "parse_mode": "HTML",
                "text": "🎬 <b>BẢN NHÁP VIDEO ĐÃ SẴN SÀNG (MAKE.COM 24/7)</b>\n\n🔴 <b>YOUTUBE SHORTS:</b>\n• <b>Tiêu đề:</b> {{5.youtube.title}}\n• <b>Tags:</b> {{5.youtube.tags}}\n\n🔵 <b>FACEBOOK REELS:</b>\n• <b>Caption:</b> {{5.facebook.caption}}\n\n🎵 <b>TIKTOK:</b>\n• <b>Hook:</b> {{5.tiktok.hook}}\n\n👇 <i>Nhấn 'DUYỆT ĐĂNG NGAY' để xuất bản lên Fanpage và YouTube:</i>",
                "reply_markup": {
                  "inline_keyboard": [
                    [
                      {
                        "text": "🚀 DUYỆT ĐĂNG NGAY",
                        "callback_data": "publish:now:{{1.message.video.file_id}}"
                      },
                      {
                        "text": "❌ HỦY",
                        "callback_data": "cancel"
                      }
                    ]
                  ]
                }
              },
              "metadata": {
                "designer": {
                  "x": 800,
                  "y": -120,
                  "name": "6. Gửi bản nháp & Nút duyệt về Telegram"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "telegram:answerCallbackQuery",
              "version": 1,
              "parameters": {},
              "mapper": {
                "callback_query_id": "{{1.callback_query.id}}",
                "text": "Đang bắt đầu xuất bản video lên Fanpage và YouTube..."
              },
              "metadata": {
                "designer": {
                  "x": 50,
                  "y": 140,
                  "name": "7. Phản hồi bấm nút Duyệt"
                }
              }
            },
            {
              "id": 8,
              "module": "http:ActionSendARequest",
              "version": 3,
              "parameters": {
                "url": "https://graph.facebook.com/v19.0/{{var.facebook_page_id}}/video_reels",
                "method": "POST",
                "qs": [
                  {
                    "name": "upload_phase",
                    "value": "start"
                  },
                  {
                    "name": "access_token",
                    "value": "{{var.facebook_page_token}}"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 300,
                  "y": 140,
                  "name": "8. Facebook Graph: Khởi tạo Reel"
                }
              }
            },
            {
              "id": 9,
              "module": "telegram:sendMessage",
              "version": 1,
              "parameters": {},
              "mapper": {
                "chat_id": "{{1.callback_query.from.id}}",
                "parse_mode": "HTML",
                "text": "🎉 <b>ĐÃ XUẤT BẢN THÀNH CÔNG (MAKE 24/7)!</b>\n\n✅ Facebook Fanpage: Đã nộp Reel lên Page ID <code>{{var.facebook_page_id}}</code>\n✅ Trạng thái: <b>ĐÃ LÊN SÓNG</b>"
              },
              "metadata": {
                "designer": {
                  "x": 550,
                  "y": 140,
                  "name": "9. Báo cáo kết quả thành công"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
