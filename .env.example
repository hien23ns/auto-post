# ==============================================================================
# ENVIRONMENT CONFIGURATION: AI AUTO VIDEO PUBLISHER 24/7
# Lưu ý: Không điền giá trị bí mật thật vào file này. Tạo bản sao .env để sử dụng.
# ==============================================================================

# Cấu hình môi trường (development / staging / production)
ENV=development
APP_NAME="AI Auto Video Publisher"
APP_HOST=0.0.0.0
# Cổng dịch vụ FastAPI (mặc định 8001 để tránh xung đột cổng 8000 đã có trên máy/VPS)
APP_PORT=8001
DEBUG=false
TIMEZONE=Asia/Ho_Chi_Minh

# Bí mật giao tiếp Webhook (Bắt buộc Make.com gửi qua Header X-Automation-Secret)
AUTOMATION_SECRET=change-me-to-a-very-secure-random-token-32-chars-min

# Telegram Bot Token & Danh sách User ID được phép tương tác (cách nhau bởi dấu phẩy)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz_EXAMPLE
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Kết nối cơ sở dữ liệu (PostgreSQL trong Docker, SQLite cho test cục bộ)
# SQLite dev: sqlite+aiosqlite:///./data/auto_post.db
# PostgreSQL: postgresql+asyncpg://postgres:postgres_password@postgres:5432/auto_post_db
DATABASE_URL=sqlite+aiosqlite:///./data/auto_post.db

# Cấu hình Google Gemini AI
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere_EXAMPLE
GEMINI_MODEL=gemini-2.5-flash

# Chế độ kiểm thử an toàn (true: chỉ tạo draft và thumbnail gửi Telegram preview, không đăng mạng xã hội)
PREVIEW_ONLY=true

# Feature Flags cho từng nền tảng
ENABLE_YOUTUBE=false
ENABLE_FACEBOOK=false
ENABLE_TIKTOK=false

# Cấu hình YouTube Data API v3 (Google Cloud OAuth 2.0)
YOUTUBE_CLIENT_ID=example-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=example-youtube-client-secret
YOUTUBE_REFRESH_TOKEN=example-youtube-refresh-token
YOUTUBE_DEFAULT_PRIVACY=private

# Cấu hình Facebook Fanpage Reels (Meta Graph API)
FACEBOOK_PAGE_ID=100000000000000
FACEBOOK_PAGE_ACCESS_TOKEN=EAAG_example_long_lived_page_access_token

# Cấu hình TikTok Content Posting API
TIKTOK_CLIENT_KEY=example_tiktok_client_key
TIKTOK_CLIENT_SECRET=example_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=example_tiktok_access_token
TIKTOK_USE_DIRECT_POST=false

# Cấu hình lưu trữ tệp (local / s3 / r2)
STORAGE_TYPE=local
MEDIA_DIR=./media
RETENTION_DAYS=7

# Cấu hình S3/R2 tương thích (nếu STORAGE_TYPE=s3 hoặc r2)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=auto-post-videos
S3_REGION=auto
